      {
        "name": "_Medidas",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "_Placeholder",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "ac24727c-52f4-46ea-a21b-87eb02d479a1",
            "sourceColumn": "_Placeholder",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "af0dec15-8b67-5cd4-a265-9f8fcdafdeb6",
        "measures": [
          {
            "name": "_Cobertura",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": [
              "VAR n = COUNTROWS(VALUES(DimDate[CalendarDate]))",
              "RETURN n > 0 && MIN(DimDate[CalendarDate]) >= DATE(2013,1,1) && MAX(DimDate[CalendarDate]) <= DATE(2016,5,31)"
            ],
            "formatString": "TRUE;TRUE;FALSE",
            "isHidden": true,
            "lineageTag": "0ffe3de8-21e4-5951-a6ce-9907a41f949a"
          },
          {
            "name": "Vendas sem impostos",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([_Cobertura], COALESCE(SUM(FactInvoiceLine[SalesExTax]),0))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "bedcb24d-fde3-53a1-9d32-1000fb53003e"
          },
          {
            "name": "Impostos",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([_Cobertura], COALESCE(SUM(FactInvoiceLine[TaxAmount]),0))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "10af9627-f005-567a-b4c2-5f2b6fbead5b"
          },
          {
            "name": "Faturamento com impostos",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([_Cobertura], COALESCE(SUM(FactInvoiceLine[ExtendedPrice]),0))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "2f8ca91f-d081-57b8-a10d-cb004a213894"
          },
          {
            "name": "Lucro comercial registrado",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([_Cobertura], COALESCE(SUM(FactInvoiceLine[LineProfit]),0))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "63701ef6-96e1-59dd-82b0-6ed58854adcc"
          },
          {
            "name": "Margem comercial registrada",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([Vendas sem impostos] > 0, DIVIDE([Lucro comercial registrado],[Vendas sem impostos]))",
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "529a5e60-3524-521a-b093-faac4c332d06"
          },
          {
            "name": "Linhas faturadas",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "02 — Volume",
            "expression": "IF([_Cobertura], COALESCE(COUNTROWS(FactInvoiceLine),0))",
            "formatString": "#,0",
            "lineageTag": "cf769e5c-ba52-596e-b040-008f90b8356a"
          },
          {
            "name": "Faturas",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "02 — Volume",
            "expression": "IF([_Cobertura], COALESCE(DISTINCTCOUNT(FactInvoiceLine[InvoiceID]),0))",
            "formatString": "#,0",
            "lineageTag": "dbd0f79d-f182-5e30-b335-191f0753d732"
          },
          {
            "name": "Clientes compradores",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "02 — Volume",
            "expression": "IF([_Cobertura], COALESCE(DISTINCTCOUNT(FactInvoiceLine[CustomerID]),0))",
            "formatString": "#,0",
            "lineageTag": "7ef1695c-a183-5124-be8c-eab2bc65c271"
          },
          {
            "name": "Contas de cobrança",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "02 — Volume",
            "expression": "IF([_Cobertura], COALESCE(DISTINCTCOUNT(FactInvoiceLine[BillToCustomerID]),0))",
            "formatString": "#,0",
            "lineageTag": "fd14015c-90dd-5f00-9972-6b7ba988cc2d"
          },
          {
            "name": "Produtos faturados",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "02 — Volume",
            "expression": "IF([_Cobertura], COALESCE(DISTINCTCOUNT(FactInvoiceLine[StockItemID]),0))",
            "formatString": "#,0",
            "lineageTag": "ae6c1231-fe98-555c-a0b2-64cb65591b32"
          },
          {
            "name": "Valor médio do recorte por fatura",
            "description": "K10. Sob produto/grupo, valor das linhas selecionadas por fatura, não da cesta inteira.",
            "displayFolder": "01 — Financeiro",
            "expression": "IF([Faturas] > 0, DIVIDE(CONVERT([Vendas sem impostos], DOUBLE),[Faturas]))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "b330d88c-103b-5191-87b4-63bff719a9ac"
          },
          {
            "name": "Linhas de lucro negativo",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "CALCULATE([Linhas faturadas], KEEPFILTERS(FactInvoiceLine[IsNegative] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "ccc52c29-865e-57b5-99f4-d34a5229e0ea"
          },
          {
            "name": "Resultado registrado das linhas negativas",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "CALCULATE([Lucro comercial registrado], KEEPFILTERS(FactInvoiceLine[IsNegative] = TRUE()))",
            "formatString": "#,0.00;-#,0.00;0.00",
            "lineageTag": "23611f12-c0d8-5aa7-867c-2427048aa90f"
          },
          {
            "name": "Linhas em condições especiais",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "CALCULATE([Linhas faturadas], KEEPFILTERS(FactInvoiceLine[IsSpecial] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "9425e345-814c-5042-9d48-a33a8f9e19ef"
          },
          {
            "name": "Negativas não especiais",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "CALCULATE([Linhas de lucro negativo], KEEPFILTERS(FactInvoiceLine[IsSpecial] = FALSE()))",
            "formatString": "#,0",
            "lineageTag": "4b9a2b59-0865-58aa-a578-5c4be2697131"
          },
          {
            "name": "Percentual de linhas negativas",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "IF([Linhas faturadas] > 0, DIVIDE([Linhas de lucro negativo],[Linhas faturadas]))",
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "dc526a4e-4158-5f9d-b11b-2e644d5c71bd"
          },
          {
            "name": "Participação das condições especiais",
            "description": "WWI sintética. Contrato Etapa 3; respeita os filtros do recorte.",
            "displayFolder": "05 — Diagnósticos",
            "expression": "IF([Vendas sem impostos] > 0, DIVIDE(CALCULATE([Vendas sem impostos], KEEPFILTERS(FactInvoiceLine[IsSpecial] = TRUE())),[Vendas sem impostos]))",
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "08a1b554-be31-5cd1-b447-8fdc4c7ce603"
          },
          {
            "name": "K11 Participação — comprador",
            "description": "K11. Um eixo de IDs/nomes indicado; filtros externos preservados. Não usar Top N nativo. Grupos sobrepostos não são aditivos.",
            "displayFolder": "03 — Participação e concentração",
            "expression": [
              "VAR denominator = CALCULATE([Vendas sem impostos], ALLSELECTED(DimBuyer[CustomerID], DimBuyer[CustomerName]))",
              "RETURN IF(denominator > 0, DIVIDE([Vendas sem impostos],denominator))"
            ],
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "c3870ade-b068-536b-bab1-36177fe836c2"
          },
          {
            "name": "K12 CR5 — comprador",
            "description": "K12. Exatamente cinco IDs (ou menos se seleção menor), desempate ID crescente. Não usar para Stock Groups.",
            "displayFolder": "03 — Participação e concentração",
            "expression": [
              "VAR selectedRevenue = CALCULATE([Vendas sem impostos], ALLSELECTED(DimBuyer[CustomerID], DimBuyer[CustomerName]))",
              "VAR entities = CALCULATETABLE(",
              "    ADDCOLUMNS(VALUES(DimBuyer[CustomerID]), \"__Revenue\", [Vendas sem impostos]),",
              "    ALLSELECTED(DimBuyer[CustomerID], DimBuyer[CustomerName]))",
              "VAR topFive = TOPN(5, entities, [__Revenue], DESC, DimBuyer[CustomerID], ASC)",
              "RETURN IF([_Cobertura] && selectedRevenue > 0, DIVIDE(SUMX(topFive,[__Revenue]),selectedRevenue))"
            ],
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "8fdd9e0e-2bdb-5558-a35e-45f3e23f845e"
          },
          {
            "name": "K11 Participação — conta",
            "description": "K11. Um eixo de IDs/nomes indicado; filtros externos preservados. Não usar Top N nativo. Grupos sobrepostos não são aditivos.",
            "displayFolder": "03 — Participação e concentração",
            "expression": [
              "VAR denominator = CALCULATE([Vendas sem impostos], ALLSELECTED(DimBillingAccount[BillToCustomerID], DimBillingAccount[BillingAccountName]))",
              "RETURN IF(denominator > 0, DIVIDE([Vendas sem impostos],denominator))"
            ],
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "dd3c2974-fa09-59ad-b663-3dd313ef771d"
          },
          {
            "name": "K12 CR5 — conta",
            "description": "K12. Exatamente cinco IDs (ou menos se seleção menor), desempate ID crescente. Não usar para Stock Groups.",
            "displayFolder": "03 — Participação e concentração",
