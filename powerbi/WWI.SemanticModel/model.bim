              "VAR entities = CALCULATETABLE(",
              "    ADDCOLUMNS(VALUES(DimBillingAccount[BillToCustomerID]), \"__Revenue\", [Vendas sem impostos]),",
              "    ALLSELECTED(DimBillingAccount[BillToCustomerID], DimBillingAccount[BillingAccountName]))",
              "VAR topFive = TOPN(5, entities, [__Revenue], DESC, DimBillingAccount[BillToCustomerID], ASC)",
              "RETURN IF([_Cobertura] && selectedRevenue > 0, DIVIDE(SUMX(topFive,[__Revenue]),selectedRevenue))"
            ],
            "formatString": "0.0000%;-0.0000%;0.0000%",
            "lineageTag": "f2acfab0-493b-5e40-b92e-d25cdd96055e"
          },
          {
            "name": "K11 Participação — produto",
            "description": "K11. Um eixo de IDs/nomes indicado; filtros externos preservados. Não usar Top N nativo. Grupos sobrepostos não são aditivos.",
            "displayFolder": "03 — Participação e concentração",
